{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://portfolio-backend-734x.onrender.com/api/:path*" },
    { "source": "/swagger-ui.html", "destination": "https://portfolio-backend-734x.onrender.com/swagger-ui/index.html" },
    { "source": "/swagger-ui/:path*", "destination": "https://portfolio-backend-734x.onrender.com/swagger-ui/:path*" },
    { "source": "/v3/api-docs/:path*", "destination": "https://portfolio-backend-734x.onrender.com/v3/api-docs/:path*" },
    { "source": "/v3/api-docs", "destination": "https://portfolio-backend-734x.onrender.com/v3/api-docs" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
